# Required to play. Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=

# Optional. Both command parsing and narration use this model.
# OPENAI_MODEL=gpt-5.4-mini

# Optional. Leave commented to use the model's default.
# GPT-6 Luna accepts none, low, medium (default), high, xhigh and max.
# OPENAI_REASONING_EFFORT=low

# Optional image model for the --visuals browser companion.
# OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Optional. Speech and Voice Design for the movie exporter.
# GEMINI_API_KEY=
# MOVIE_NARRATOR_VOICE=   # Override the narrator selected from the saved character.
# MOVIE_GIANT_VOICE=Algenib
# MOVIE_GEMINI_MODEL=auto
